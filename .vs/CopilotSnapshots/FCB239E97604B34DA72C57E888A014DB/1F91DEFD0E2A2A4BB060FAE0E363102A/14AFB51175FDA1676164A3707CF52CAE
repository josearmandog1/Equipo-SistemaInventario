using System;
using System.Collections.Generic;

class Producto
{
    // Product properties
    public string Codigo, Nombre;
    public decimal Precio;
    public int Cantidad;
    public string Categoria;

    public Producto(string codigo, string nombre, decimal precio, int cantidad, string categoria)
    {
        Codigo = codigo; Nombre = nombre; Precio = precio; Cantidad = cantidad; Categoria = categoria;
    }

    public override string ToString() =>
        $"[{Codigo}] {Nombre} - ${Precio} - Cant: {Cantidad} - {Categoria}";
}

class Almacen
{
    List<Producto> productos = new List<Producto>();
    public List<string> Categorias = new List<string> { "Electronica", "Oficina", "Hogar" };

    public bool Registrar(Producto p)
    {
        if (BuscarPorCodigo(p.Codigo) != null) return false;
        productos.Add(p);
        return true;
    }

    public Producto BuscarPorCodigo(string codigo) => productos.Find(p => p.Codigo == codigo);

    public bool Eliminar(string codigo)
    {
        var p = BuscarPorCodigo(codigo);
        return p != null && productos.Remove(p);
    }

    public List<Producto> Listar() => productos;

    public List<Producto> PorCategoria(string categoria) =>
        productos.FindAll(p => p.Categoria.Equals(categoria, StringComparison.OrdinalIgnoreCase));

    public List<Producto> Agotados() => productos.FindAll(p => p.Cantidad == 0);

    public string Resumen()
    {
        int unidades = 0; decimal valor = 0;
        foreach (var p in productos) { unidades += p.Cantidad; valor += p.Precio * p.Cantidad; }
        return $"Productos: {productos.Count} | Unidades: {unidades} | Valor total: ${valor}";
    }
}

class Program
{
    static Almacen almacen = new Almacen();

    static void Main()
    {
        string opcion;
        do
        {
            Console.WriteLine("\n1.Registrar \n2.Buscar \n3.Eliminar \n4.Listar \n5.PorCategoria \n6.Agotados \n7.Resumen \n0.Salir");
            Console.Write("Opcion: ");
            opcion = Console.ReadLine();

            switch (opcion)
            {
                case "1": Registrar(); break;
                case "2": Buscar(); break;
                case "3": Eliminar(); break;
                case "4": Listar(almacen.Listar()); break;
                case "5": PorCategoria(); break;
                case "6": Listar(almacen.Agotados()); break;
                case "7": Console.WriteLine(almacen.Resumen()); break;
            }
        } while (opcion != "0");
    }


    static void Registrar()
    {
        // Clear screen and collect product data with validation
        Console.Clear();

        // Read and validate code (non-empty)
        string codigo;
        do
        {
            Console.Write("Codigo: ");
            codigo = Console.ReadLine()?.Trim();
            if (string.IsNullOrEmpty(codigo))
                Console.WriteLine("Codigo no puede estar vacío.");
        } while (string.IsNullOrEmpty(codigo));

        // Read and validate name (non-empty)
        string nombre;
        do
        {
            Console.Write("Nombre: ");
            nombre = Console.ReadLine()?.Trim();
            if (string.IsNullOrEmpty(nombre))
                Console.WriteLine("Nombre no puede estar vacío.");
        } while (string.IsNullOrEmpty(nombre));

        // Read and validate price (decimal >= 0)
        decimal precio;
        while (true)
        {
            Console.Write("Precio: ");
            var textoPrecio = Console.ReadLine();
            if (decimal.TryParse(textoPrecio, out precio) && precio >= 0)
                break;
            Console.WriteLine("Ingrese un precio válido (número, mayor o igual a 0).");
        }

        // Read and validate quantity (integer >= 0)
        int cantidad;
        while (true)
        {
            Console.Write("Cantidad: ");
            var textoCant = Console.ReadLine();
            if (int.TryParse(textoCant, out cantidad) && cantidad >= 0)
                break;
            Console.WriteLine("La cantidad debe ser un número entero mayor o igual a cero.");
        }

        // Let user choose a category from the available list (validate selection)
        string categoria = null;
        while (true)
        {
            Console.WriteLine("Categorias:");
            for (int i = 0; i < almacen.Categorias.Count; i++)
                Console.WriteLine($"  {i + 1}. {almacen.Categorias[i]}");
            Console.Write("Seleccione categoria (ingrese número o nombre): ");
            var entradaCat = Console.ReadLine()?.Trim();
            if (int.TryParse(entradaCat, out int idx) && idx >= 1 && idx <= almacen.Categorias.Count)
            {
                categoria = almacen.Categorias[idx - 1];
                break;
            }
            else if (!string.IsNullOrEmpty(entradaCat))
            {
                // Accept name if it matches an existing category (case-insensitive)
                var match = almacen.Categorias.Find(c => c.Equals(entradaCat, StringComparison.OrdinalIgnoreCase));
                if (match != null) { categoria = match; break; }
            }
            Console.WriteLine("Categoria inválida. Intente de nuevo.");
        }

        // Attempt to register the product
        if (almacen.Registrar(new Producto(codigo, nombre, precio, cantidad, categoria)))
            Console.WriteLine("Producto registrado.");
        else
            Console.WriteLine("Ya existe un producto con ese codigo.");
    }
    static void Buscar()
    {
        // Search a product by code with non-empty input
        Console.Clear();
        string codigo;
        do
        {
            Console.Write("Codigo: ");
            codigo = Console.ReadLine()?.Trim();
            if (string.IsNullOrEmpty(codigo)) Console.WriteLine("Codigo no puede estar vacío.");
        } while (string.IsNullOrEmpty(codigo));
        var p = almacen.BuscarPorCodigo(codigo);
        Console.WriteLine(p == null ? "No encontrado." : p.ToString());
    }

    static void Eliminar()
    {
        // Delete product by code (validate input)
        Console.Clear();
        string codigo;
        do
        {
            Console.Write("Codigo: ");
            codigo = Console.ReadLine()?.Trim();
            if (string.IsNullOrEmpty(codigo)) Console.WriteLine("Codigo no puede estar vacío.");
        } while (string.IsNullOrEmpty(codigo));

        Console.WriteLine(almacen.Eliminar(codigo) ? "Eliminado." : "No encontrado.");
    }
    static void PorCategoria()
    {
        // List products by category, validating input against available categories
        Console.Clear();
        string categoria;
        while (true)
        {
            Console.WriteLine("Categorias: " + string.Join(", ", almacen.Categorias));
            Console.Write("Categoria: ");
            var entrada = Console.ReadLine()?.Trim();
            if (!string.IsNullOrEmpty(entrada))
            {
                var match = almacen.Categorias.Find(c => c.Equals(entrada, StringComparison.OrdinalIgnoreCase));
                if (match != null) { categoria = match; break; }
            }
            Console.WriteLine("Categoria inválida. Intente de nuevo.");
        }
        Listar(almacen.PorCategoria(categoria));
    }

    static void Listar(List<Producto> lista)
    {
        Console.Clear();
        if (lista.Count == 0) { Console.WriteLine("Sin resultados."); return; }
        foreach (var p in lista) Console.WriteLine(p);
    }
}

